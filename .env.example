# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OLLAMA_BASE=http://localhost:11434
CODEX_ACCESS_TOKEN=
CODEX_OAUTH_CLIENT_ID=
CODEX_OAUTH_CLIENT_SECRET=
CODEX_OAUTH_REFRESH_TOKEN=
CODEX_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
CODEX_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
CODEX_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
CODEX_OAUTH_SCOPE=openid profile email offline_access
CODEX_BASE_URL=https://chatgpt.com/backend-api
CODEX_ACCOUNT_ID=
CODEX_TOKEN_EXPIRES_AT=

# Default Settings
LLM_PROVIDER=gemini
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_OLLAMA_MODEL=gpt-oss
DEFAULT_CODEX_MODEL=gpt-5-codex

MAX_CONTEXT_TOKENS=50000
MAX_TIMEOUT_SECONDS=180

# Security Settings
REQUIRE_SUDO_APPROVAL=true
SANDBOX_MODE=true
MAX_RATE_LIMIT=10

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=data/logs/audit.log

# Session Management
SESSION_DIR=data/sessions
AUTO_SAVE_INTERVAL=300
