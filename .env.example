# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE=http://localhost:11434

# Default Settings
LLM_PROVIDER=gemini
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_OLLAMA_MODEL=gpt-oss
DEFAULT_NVIDIA_MODEL=z-ai/glm-5.2
DEFAULT_CODEX_MODEL=gpt-5-codex

MAX_CONTEXT_TOKENS=50000
MAX_TIMEOUT_SECONDS=180

# Windows only: shell the exec/process tools wrap commands in.
# One of cmd | powershell | pwsh. Defaults to cmd. Ignored on POSIX (bash).
# WINDOWS_DEFAULT_SHELL=cmd

# Per-turn cap on output tokens the model is allowed to generate. Leave unset
# to use the model's own maximum (queried from the provider when available, or
# unbounded for providers that don't enforce a cap). Set a smaller value to
# clamp cost/latency at the risk of truncating long responses.
# MAX_RESPONSE_TOKENS=8192

# Sampling temperature for the main agent loop. Leave unset (default) to use
# the provider's own tuned default — recommended. Override only if you have a
# specific reason. Accepted range: 0.0–2.0 (Anthropic/Ollama cap at 1.0;
# Codex Responses ignores this value entirely).
# AGENT_TEMPERATURE=0.2

# Agent subsystem caps. AGENT_MAX_ITERATIONS is a process-wide cap; profile
# max_iterations values may lower it for specific agents, but not raise it.
# AGENT_MAX_DEPTH=2
# AGENT_MAX_TOTAL=20
# AGENT_MAX_BATCH=5
# AGENT_MAX_ITERATIONS=30

# HTTP Tool
# Path to the YAML file describing named credential profiles for HTTPTool.
# Default: config/http_profiles.yaml. Override only if you store profiles elsewhere.
# HTTP_PROFILES_PATH=config/http_profiles.yaml

# HackTheBox (used by skills/htb-machine-setup and skills/htb-machine-solve).
# Generate the App Token at https://app.hackthebox.com/profile/settings.
# Once set, uncomment the `htb` profile block in config/http_profiles.yaml.
# HTB_API_TOKEN=your_htb_app_token_here
#
# HTB_VPN_CONFIG is OPTIONAL — htb-machine-setup auto-downloads the .ovpn
# from the HTB API and caches it under data/htb/vpn/. Set this only if you
# want to force a specific .ovpn file (e.g. one you downloaded manually).
# HTB_VPN_CONFIG=/absolute/path/to/lab_user.ovpn

# Web Search (WebSearchTool)
# The web_search tool is only registered when SEARCH_API_KEY is set — leave it
# blank to disable web search entirely. Default backend is Tavily
# (https://tavily.com — free tier, no card). Get a key from the Tavily dashboard.
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=tvly-your_key_here
# SEARCH_MAX_RESULTS=10
# SEARCH_TIMEOUT_SECONDS=15

# Security Settings
REQUIRE_SUDO_APPROVAL=true
SANDBOX_MODE=true
MAX_RATE_LIMIT=10

# Autonomy Settings
AUTONOMY_LEVEL=2
ALLOW_AUTONOMOUS=false

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=data/logs/audit.log

# Session Management
SESSION_DIR=data/sessions
AUTO_SAVE_INTERVAL=300
