# LLM credentials are normally entered through Kerkov's masked terminal prompt
# and saved in the operating-system keyring. On a headless/SSH system without a
# keyring, `auto` falls back to ~/.kerkov/credentials.json with mode 0600.
# Set `keyring` to forbid file fallback or `file` to choose it explicitly.
# KERKOV_CREDENTIAL_STORE=auto
# KERKOV_CREDENTIAL_FILE=~/.kerkov/credentials.json
#
# The API-key environment variables below are optional compatibility overrides
# for CI and other non-interactive deployments.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama prompts for its server URL and saves it in ~/.kerkov/settings.json.
# This optional environment value is useful for non-interactive deployments.
# OLLAMA_BASE=http://localhost:11434

# Default Settings
LLM_PROVIDER=gemini
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_OLLAMA_MODEL=gpt-oss
DEFAULT_NVIDIA_MODEL=z-ai/glm-5.2
DEFAULT_OPENROUTER_MODEL=openrouter/auto
DEFAULT_CODEX_MODEL=gpt-5.4

# Optional OpenRouter attribution headers shown in OpenRouter rankings/analytics.
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=Kerkov

MAX_CONTEXT_TOKENS=50000
MAX_TIMEOUT_SECONDS=180

# Windows only: shell the exec/process tools wrap commands in.
# One of cmd | powershell | pwsh. Defaults to cmd. Ignored on POSIX (bash).
# WINDOWS_DEFAULT_SHELL=cmd

# Per-turn cap on output tokens the model is allowed to generate. Leave unset
# to use the model's own maximum (queried from the provider when available, or
# unbounded for providers that don't enforce a cap). Set a smaller value to
# clamp cost/latency at the risk of truncating long responses.
# MAX_RESPONSE_TOKENS=8192

# Sampling temperature for the main agent loop. Leave unset (default) to use
# the provider's own tuned default — recommended. Override only if you have a
# specific reason. Accepted range: 0.0–2.0 (Anthropic/Ollama cap at 1.0;
# Codex Responses ignores this value entirely).
# AGENT_TEMPERATURE=0.2

# Agent subsystem caps. AGENT_MAX_ITERATIONS is a process-wide cap; profile
# max_iterations values may lower it for specific agents, but not raise it.
# AGENT_MAX_DEPTH=2
# AGENT_MAX_TOTAL=20
# AGENT_MAX_BATCH=5
# AGENT_MAX_ITERATIONS=30

# HTTP Tool
# Path to the YAML file describing named credential profiles for HTTPTool.
# Default: config/http_profiles.yaml. Override only if you store profiles elsewhere.
# HTTP_PROFILES_PATH=config/http_profiles.yaml

# HackTheBox (used by skills/htb-machine-setup and skills/htb-machine-solve).
# Generate the App Token at https://app.hackthebox.com/profile/settings.
# Legacy/non-interactive override. In the interactive CLI, the HTB profile asks
# for this value securely on first use and persists it outside .env.
# HTB_API_TOKEN=your_htb_app_token_here
#
# HTB_VPN_CONFIG is OPTIONAL — htb-machine-setup auto-downloads the .ovpn
# from the HTB API and caches it under data/htb/vpn/. Set this only if you
# want to force a specific .ovpn file (e.g. one you downloaded manually).
# HTB_VPN_CONFIG=/absolute/path/to/lab_user.ovpn

# Web Search (WebSearchTool)
# The web_search tool is only registered when the selected provider is
# configured or, for Tavily, when an interactive credential prompt is available.
# Leave both provider-specific settings below blank to disable web search in
# non-interactive use.
#
# Tavily (default): commercial API (https://tavily.com — free tier, no card).
# The first interactive web_search call opens a masked key prompt when no saved
# key exists. You can also enter it in advance with `/auth set tavily`.
# SEARCH_API_KEY remains available as a non-interactive compatibility override.
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=tvly-your_key_here
#
# SearXNG: self-hosted metasearch aggregator (no API key, no per-query cost).
# It scrapes public engines on each query, so it still makes outbound requests
# (not air-gapped) and can be flaky. Requires SEARCH_BASE_URL instead of a key.
# The instance must expose the JSON API — set `search.formats: [html, json]`
# in its settings.yml. Run one quickly with Docker:
#   docker run --rm -p 8080:8080 searxng/searxng
# SEARCH_PROVIDER=searxng
# SEARCH_BASE_URL=http://127.0.0.1:8080
#
# Shared (both providers):
# SEARCH_MAX_RESULTS=10
# SEARCH_TIMEOUT_SECONDS=15

# Experimental local web console. The defaults are intentionally loopback-only,
# use DEBUG=false, and generate fresh process-local secrets. Normally none of
# these need to be set.
# KERKOV_WEB_DEBUG=0
# KERKOV_WEB_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# KERKOV_WEB_SECRET_KEY=replace-with-a-long-random-value
# KERKOV_WEB_ACCESS_TOKEN=replace-with-a-long-url-safe-ascii-value

# CVE Lookup (CveLookupTool)
# All sources (NVD, CISA-KEV, EPSS) are keyless, so the tool is always
# registered and needs no configuration. NVD_API_KEY is optional and only
# raises NVD's rate limit from 5 to 50 requests per 30s — request one at
# https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your_nvd_api_key_here
#
# Shared TTL disk cache for CVE records, so a CVE looked up in one engagement
# is free in the next. A relative path is anchored to your home directory.
# INTEL_CACHE_DIR=~/.kerkov/cache/intel
# CVE_CACHE_TTL_HOURS=24
# CVE_LOOKUP_TIMEOUT_SECONDS=15

# OWASP ZAP (ZapTool)
# The first approved scan automatically generates an API key, starts the
# official stable Docker image on loopback, validates readiness, and saves the
# URL in ~/.kerkov/settings.json. The settings below are optional
# non-interactive/operator overrides. Keep remote access disabled unless the
# endpoint is on a trusted network and separately protected.
# ZAP_API_KEY=generated_or_operator_supplied_key
# ZAP_API_URL=http://127.0.0.1:8090
# ZAP_API_TIMEOUT_SECONDS=15
# ZAP_API_VERIFY_TLS=true
# ZAP_API_ALLOW_REMOTE=false
# ZAP_STARTUP_TIMEOUT_SECONDS=180
# ZAP_DOCKER_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# ZAP_DOCKER_CONTAINER_NAME=kerkov-zap

# Security Settings
REQUIRE_SUDO_APPROVAL=true
# Process-executing tools (`exec` and `container_lifecycle`) and the write tool
# are enabled by default. Standard approval mode still prompts for unmatched
# calls. Set either gate to false to disable that capability.
EXECUTION_ENABLED=true
WRITE_TOOL_ENABLED=true
MAX_RATE_LIMIT=10

# Autonomy Settings
AUTONOMY_LEVEL=2
ALLOW_AUTONOMOUS=false

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=data/logs/audit.log

# Session Management
SESSION_DIR=data/sessions
AUTO_SAVE_INTERVAL=300
