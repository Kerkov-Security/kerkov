name: build-kerkov

on:
  pull_request:
    branches:
      - main
  workflow_dispatch:

concurrency:
  group: build-kerkov-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    permissions:
      contents: read

    steps:
      - name: Check out Kerkov
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4.2.0

      - name: Build AMD64 integration image
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7.3.0
        with:
          context: .
          file: ./image/Dockerfile
          build-args: |
            KERKOV_SOURCE_REVISION=${{ github.sha }}
          platforms: linux/amd64
          pull: true
          load: true
          tags: kerkov:ci
          cache-from: type=gha,scope=kerkov-amd64
          cache-to: type=gha,mode=max,scope=kerkov-amd64

      - name: Test default Compose stack
        env:
          KERKOV_IMAGE: kerkov:ci
          ZAP_API_KEY: kerkov-ci-${{ github.run_id }}-${{ github.run_attempt }}
        run: bash .github/scripts/compose-smoke-test.sh
