<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_example_benchmark_linux">
  <status date="2026-10-25">draft</status>
  <title>Fixture Linux baseline</title>
  <version>1.0</version>
  <Profile id="xccdf_example_profile_server"><title>Fixture server</title></Profile>
  <Group id="xccdf_example_group_system">
    <Rule id="xccdf_example_rule_ssh" severity="high">
      <title>Disable direct <sub xmlns="http://www.w3.org/1999/xhtml">root</sub> SSH login</title>
      <ident system="https://example.org/controls">EXAMPLE-1</ident>
      <fix system="urn:xccdf:fix:script:sh">raw-secret-remediation</fix>
    </Rule>
    <Rule id="xccdf_example_rule_permissions" severity="medium"><title>Check file permissions</title></Rule>
  </Group>
  <TestResult id="xccdf_example_testresult_before" start-time="2026-10-25T10:00:00Z"
              end-time="2026-10-25T10:01:00Z" test-system="cpe:/a:redhat:openscap:1.4">
    <benchmark href="ssg-example-ds.xml" id="xccdf_example_benchmark_linux"/>
    <title>Fixture assessment</title>
    <profile idref="xccdf_example_profile_server"/>
    <target>server-one</target>
    <rule-result idref="xccdf_example_rule_ssh" severity="high">
      <result>fail</result><ident system="https://example.org/controls">EXAMPLE-1</ident>
      <message severity="info">raw-secret-check-output</message>
    </rule-result>
    <rule-result idref="xccdf_example_rule_permissions"><result>pass</result><instance>/etc/passwd</instance></rule-result>
    <rule-result idref="xccdf_example_rule_permissions"><result>fail</result><instance>/etc/shadow</instance></rule-result>
    <rule-result idref="xccdf_example_rule_error"><result>error</result></rule-result>
    <rule-result idref="xccdf_example_rule_unknown"><result>unknown</result></rule-result>
    <rule-result idref="xccdf_example_rule_manual"><result>notchecked</result></rule-result>
    <rule-result idref="xccdf_example_rule_unselected"><result>notselected</result></rule-result>
    <rule-result idref="xccdf_example_rule_na"><result>notapplicable</result></rule-result>
    <rule-result idref="xccdf_example_rule_info"><result>informational</result></rule-result>
    <rule-result idref="xccdf_example_rule_fixed"><result>fixed</result></rule-result>
    <score system="urn:xccdf:scoring:default" maximum="100">75.0</score>
  </TestResult>
</Benchmark>
